CLICKHOUSE_DB=amarenl_analytics
CLICKHOUSE_USER=amarenl
CLICKHOUSE_PASSWORD=changeme

# Used by scripts/ingest-meta-ads.mjs — System User token, never expires.
# Kept here (not amarenl.com/.env.local) so the analytics cron is self-contained.
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=

# Used by scripts/track-competitor-ads.mjs — must be a personal, ID-verified
# User Access Token (System User tokens are rejected by the Ad Library API
# for EU-reached ads). Long-lived, expires in 60 days — see README for the
# refresh command.
META_USER_ACCESS_TOKEN=
